# Generated Vite production profile for portal Release Packaging.
# Empty backends: SPA uses same-origin /api (CD mounts REST_BASE_URL).
# Copy this file to the React repo root as .env.production.
# Do not put Stripe sk_, REST/Haystack hosts, JWT, RDS, or localhost:8080 here.
VITE_API_URL=
VITE_REST_URL=
VITE_REST_BASE_URL=
VITE_HAYSTACK_URL=
VITE_HAYSTACK_BASE_URL=
