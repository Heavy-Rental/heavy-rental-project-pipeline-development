server {
    listen 80 default_server;
    server_name _;

    # Keep /api on the upstream URI. Spring maps /api/auth/**, /api/assets, …
    # proxy_pass with a trailing path (/) would strip /api and Spring would
    # 401 /auth/login (no matcher; default deny).
    location /api/ {
        proxy_pass {{ rest_base_url.stdout.rstrip('/') }};
        proxy_http_version 1.1;
        # REST ALB host from proxy_pass — not the client Host header.
        proxy_set_header Host $proxy_host;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Drop Origin. Empty value means nginx omits the header. The SPA is
        # same-origin /api; fetch() still sends Origin. Spring CorsFilter then
        # treats the hairpin as CORS and 403s "Invalid CORS request" when the
        # address bar does not exactly match APP_CORS_ALLOWED_ORIGINS.
        proxy_set_header Origin "";
    }

    location / {
        root /usr/share/nginx/html;
        try_files $uri $uri/ /index.html;
    }
}
